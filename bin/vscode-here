#!/bin/sh
# Triggered by Karabiner (Ctrl+Option+Cmd+C): open the front Finder window's folder in VS Code.
DIR=$(/usr/bin/osascript -e 'tell application "Finder" to if (count of Finder windows) > 0 then get POSIX path of (target of front Finder window as alias)')
if [ -d "$DIR" ]; then
  /usr/bin/open -a "/Applications/Visual Studio Code.app" "$DIR"
else
  /usr/bin/open -a "/Applications/Visual Studio Code.app"
fi

#!/bin/zsh
# theme — switch the whole desktop's colour theme.
#
#   theme              fzf picker with live colour preview
#   theme <name>       apply a theme (palette file in ~/.config/themes/palettes/<name>.sh)
#   theme --list       list themes; theme --current prints the active one
#   theme --wallpaper <image…>   add image(s) to the current theme's wallpapers and show one
#   theme --next-wallpaper       switch to another of the current theme's wallpapers
#   theme --set-wallpaper <image> show that exact image (Hyper+G picker uses this)
#   theme --new <name> [from]    new theme copied from [from] (default: current), opens it to edit
#
# Applies to: wallpaper, macOS light/dark mode, Alacritty, SketchyBar, JankyBorders,
# Neovim (running instances too), Zed, Zellij, btop, iTerm2, VS Code, Discord (via Vencord), Firefox (via Pywalfox) and Spotify (via Spicetify).
# Wallpapers: any images in ~/.config/themes/wallpapers/<name>/ (one picked at random),
# else wallpapers/<name>.<ext>, else a generated gradient (wallpapers/generated/).

THEMES=$HOME/.config/themes
PALETTES=$THEMES/palettes
CURRENT=$THEMES/current
export PATH=/opt/homebrew/bin:$PATH

list() { for f in $PALETTES/*.sh(N); do echo ${f:t:r}; done }

preview() {
  source $PALETTES/$1.sh
  sw() { printf '\e[48;2;%d;%d;%dm      \e[0m' 0x${1[1,2]} 0x${1[3,4]} 0x${1[5,6]} }
  fg() { printf '\e[38;2;%d;%d;%dm%s\e[0m' 0x${1[1,2]} 0x${1[3,4]} 0x${1[5,6]} "$2" }
  print -P "%B$THEME_LABEL%b  ($THEME_MODE)\n"
  for row in "BASE MANTLE CRUST SURFACE0 SURFACE1 SURFACE2" "RED PEACH YELLOW GREEN TEAL BLUE" "MAUVE PINK LAVENDER SKY SAPPHIRE FLAMINGO"; do
    for k in ${=row}; do sw ${(P)k}; printf ' '; done; print
  done
  print
  fg $ACCENT "accent"; printf '  '; fg $TEXT "text"; printf '  '; fg $SUBTEXT0 "subtext"; printf '  '; fg $OVERLAY0 "overlay"
  print "\n"
  local wp=$(wallpaper_for $1)
  [[ -n $wp ]] && print "wallpaper: ${wp:t}" || print "wallpaper: (generated on first use)"
}

# Pick a wallpaper for theme $1: user images first (avoiding the one showing now), else generated.
wallpaper_for() {
  local w=$THEMES/wallpapers
  local imgs=($w/$1/*.(png|jpg|jpeg|heic|webp|PNG|JPG|JPEG|HEIC)(N) $w/$1.(png|jpg|jpeg|heic|webp)(N))
  local now=$(cat $CURRENT/wallpaper 2>/dev/null)
  (( $#imgs > 1 )) && imgs=(${imgs:#$now})
  if (( $#imgs )); then echo ${imgs[RANDOM % $#imgs + 1]}
  elif [[ -f $w/generated/$1.png ]]; then echo $w/generated/$1.png
  fi
}

apply_alacritty() {
  local black white bblack bwhite
  if [[ $THEME_MODE == light ]]; then black=$SUBTEXT1 white=$SURFACE2 bblack=$SUBTEXT0 bwhite=$SURFACE1
  else black=$SURFACE1 white=$SUBTEXT1 bblack=$SURFACE2 bwhite=$SUBTEXT0; fi
  cat > $HOME/.config/alacritty/theme.toml <<EOF
# Generated by ~/.local/bin/theme ($NAME) — do not edit; edit the palette instead.
[colors.primary]
background = "#$BASE"
foreground = "#$TEXT"
[colors.cursor]
text = "#$BASE"
cursor = "#$ROSEWATER"
[colors.selection]
text = "#$BASE"
background = "#$ROSEWATER"
[colors.search.matches]
foreground = "#$BASE"
background = "#$SUBTEXT0"
[colors.normal]
black = "#$black"
red = "#$RED"
green = "#$GREEN"
yellow = "#$YELLOW"
blue = "#$BLUE"
magenta = "#$PINK"
cyan = "#$TEAL"
white = "#$white"
[colors.bright]
black = "#$bblack"
red = "#$RED"
green = "#$GREEN"
yellow = "#$YELLOW"
blue = "#$BLUE"
magenta = "#$PINK"
cyan = "#$TEAL"
white = "#$bwhite"
EOF
}

apply_btop() {
  mkdir -p $HOME/.config/btop/themes
  cat > $HOME/.config/btop/themes/theme-switcher.theme <<EOF
# Generated by ~/.local/bin/theme ($NAME)
theme[main_bg]="#$BASE"
theme[main_fg]="#$TEXT"
theme[title]="#$TEXT"
theme[hi_fg]="#$BLUE"
theme[selected_bg]="#$SURFACE1"
theme[selected_fg]="#$BLUE"
theme[inactive_fg]="#$OVERLAY1"
theme[graph_text]="#$ROSEWATER"
theme[meter_bg]="#$SURFACE1"
theme[proc_misc]="#$ROSEWATER"
theme[cpu_box]="#$MAUVE"
theme[mem_box]="#$GREEN"
theme[net_box]="#$MAROON"
theme[proc_box]="#$BLUE"
theme[div_line]="#$OVERLAY0"
theme[temp_start]="#$GREEN"
theme[temp_mid]="#$YELLOW"
theme[temp_end]="#$RED"
theme[cpu_start]="#$TEAL"
theme[cpu_mid]="#$SAPPHIRE"
theme[cpu_end]="#$LAVENDER"
theme[free_start]="#$MAUVE"
theme[free_mid]="#$LAVENDER"
theme[free_end]="#$BLUE"
theme[cached_start]="#$SAPPHIRE"
theme[cached_mid]="#$BLUE"
theme[cached_end]="#$LAVENDER"
theme[available_start]="#$PEACH"
theme[available_mid]="#$MAROON"
theme[available_end]="#$RED"
theme[used_start]="#$GREEN"
theme[used_mid]="#$TEAL"
theme[used_end]="#$SKY"
theme[download_start]="#$PEACH"
theme[download_mid]="#$MAROON"
theme[download_end]="#$RED"
theme[upload_start]="#$GREEN"
theme[upload_mid]="#$TEAL"
theme[upload_end]="#$SKY"
theme[process_start]="#$SAPPHIRE"
theme[process_mid]="#$LAVENDER"
theme[process_end]="#$MAUVE"
EOF
  sed -i '' 's|^color_theme = .*|color_theme = "theme-switcher"|' $HOME/.config/btop/btop.conf
}

apply_zed() {
  local f=$HOME/.config/zed/settings.json
  [[ -f $f && -n $ZED_THEME ]] || return
  /usr/bin/python3 - "$f" "$THEME_MODE" "$ZED_THEME" <<'PY'
import re, sys
path, mode, name = sys.argv[1:]
s = open(path).read()
def fix(m):
    block = re.sub(r'"mode":\s*"[^"]*"', f'"mode": "{mode}"', m.group(0))
    return re.sub(rf'"{mode}":\s*"[^"]*"', f'"{mode}": "{name}"', block)
s = re.sub(r'"theme":\s*\{[^}]*\}', fix, s, count=1)
open(path, "w").write(s)
PY
}

apply_zellij() {
  local f=$HOME/.config/zellij/config.kdl
  [[ -f $f ]] || return
  if [[ -z $ZELLIJ_THEME ]]; then  # no built-in Zellij theme: generate one from the palette
    ZELLIJ_THEME=theme-switcher
    mkdir -p $HOME/.config/zellij/themes
    cat > $HOME/.config/zellij/themes/theme-switcher.kdl <<EOF
// Generated by ~/.local/bin/theme ($NAME)
themes {
    theme-switcher {
        fg "#$TEXT"
        bg "#$SURFACE1"
        black "#$MANTLE"
        red "#$RED"
        green "#$GREEN"
        yellow "#$YELLOW"
        blue "#$BLUE"
        magenta "#$MAUVE"
        cyan "#$TEAL"
        white "#$TEXT"
        orange "#$PEACH"
    }
}
EOF
  fi
  if grep -q '^theme "' $f; then sed -i '' "s|^theme \".*\"|theme \"$ZELLIJ_THEME\"|" $f
  else printf '\ntheme "%s"\n' "$ZELLIJ_THEME" >> $f; fi
}

apply_nvim() {
  echo $NVIM_COLORSCHEME > $CURRENT/nvim-colorscheme
  echo $THEME_MODE > $CURRENT/mode
  # Live-switch any running Neovim instances.
  for sock in ${TMPDIR:-/tmp}/nvim.$USER/*/nvim.*(N=); do
    nvim --server $sock --remote-expr "execute('set background=$THEME_MODE | colorscheme $NVIM_COLORSCHEME')" >/dev/null 2>&1
  done
}

apply_firefox() {
  # Pywalfox (Firefox extension + ~/.local/bin/pywalfox) reads pywal's colours.json and
  # recolours Firefox live. Index order matters to Pywalfox: 0 = background, 1/2 = accents.
  mkdir -p $HOME/.cache/wal
  cat > $HOME/.cache/wal/colors.json <<EOF
{
  "wallpaper": "$(cat $CURRENT/wallpaper 2>/dev/null)",
  "special": { "background": "#$BASE", "foreground": "#$TEXT", "cursor": "#$ROSEWATER" },
  "colors": {
    "color0": "#$BASE", "color1": "#$ACCENT", "color2": "#$BLUE", "color3": "#$YELLOW",
    "color4": "#$TEAL", "color5": "#$PINK", "color6": "#$PEACH", "color7": "#$SUBTEXT1",
    "color8": "#$SURFACE1", "color9": "#$ACCENT", "color10": "#$BLUE", "color11": "#$YELLOW",
    "color12": "#$TEAL", "color13": "#$PINK", "color14": "#$PEACH", "color15": "#$TEXT"
  }
}
EOF
  local pwf=$HOME/.local/bin/pywalfox
  [[ -x $pwf ]] || return
  $pwf $THEME_MODE >/dev/null 2>&1
  $pwf update >/dev/null 2>&1
}

apply_spotify() {
  # Spicetify theme "Rice": regenerate its colours. Spicetify has to restart Spotify to
  # apply them, so do that only when Spotify isn't playing (otherwise: next launch).
  local dir=$HOME/.config/spicetify/Themes/Rice
  command -v spicetify >/dev/null && [[ -d $dir ]] || return
  cat > $dir/color.ini <<EOF
; Generated by ~/.local/bin/theme ($NAME)
[current]
text               = $TEXT
subtext            = $SUBTEXT0
main               = $BASE
main-elevated      = $SURFACE0
highlight          = $SURFACE0
highlight-elevated = $SURFACE1
sidebar            = $MANTLE
player             = $MANTLE
card               = $SURFACE0
shadow             = $CRUST
selected-row       = $OVERLAY2
button             = $ACCENT
button-active      = $ACCENT
button-secondary   = $OVERLAY1
button-disabled    = $SURFACE2
tab-active         = $SURFACE1
notification       = $SURFACE1
notification-error = $RED
misc               = $OVERLAY0
EOF
  # Spotify closed: update its files without launching it (plain `refresh` starts Spotify)
  if ! pgrep -xq Spotify; then spicetify refresh -n >/dev/null 2>&1; return; fi
  spicetify refresh >/dev/null 2>&1   # updates Spotify's files; needs a restart to show
  if [[ $(osascript -e 'tell application "Spotify" to player state as string' 2>/dev/null) == playing ]]; then
    print "  Spotify: colours apply on its next launch (music playing)"
  else
    # (`spicetify restart` relaunches before Spotify has exited and the relaunch gets lost)
    # Quitting Spotify empties workspace S and macOS focuses some other app, which makes
    # AeroSpace jump to that app's workspace — so remember where we were and go back.
    local ws=$(aerospace list-workspaces --focused 2>/dev/null)
    osascript -e 'quit app "Spotify"' >/dev/null 2>&1
    for _ in {1..20}; do pgrep -xq Spotify || break; sleep 0.5; done
    open -ga /Applications/Spotify.app   # -g: don't pull focus to workspace S
    for _ in {1..30}; do
      aerospace list-windows --all --format '%{app-bundle-id}' 2>/dev/null | grep -q com.spotify.client && break
      sleep 0.5
    done
    [[ -n $ws && $(aerospace list-workspaces --focused) != $ws ]] && aerospace workspace $ws
  fi
}

apply_vscode() {
  local f="$HOME/Library/Application Support/Code/User/settings.json"
  [[ -f $f && -n $VSCODE_THEME ]] || return
  /usr/bin/python3 - "$f" "$VSCODE_THEME" <<'PY'
import re, sys
path, name = sys.argv[1:]
s = open(path).read()
if re.search(r'"workbench\.colorTheme"\s*:', s):
    s = re.sub(r'("workbench\.colorTheme"\s*:\s*)"[^"]*"', lambda m: m.group(1) + '"' + name + '"', s, count=1)
else:
    s = s.replace("{", '{\n  "workbench.colorTheme": "' + name + '",', 1)
open(path, "w").write(s)
PY
}

apply_iterm() {
  # New tabs: dynamic profile "Rice" (inherits font/transparency from "Default"; iTerm
  # reloads it live). Open tabs: recolour each iTerm session's tty with escape codes.
  local dir="$HOME/Library/Application Support/iTerm2/DynamicProfiles"
  [[ -d /Applications/iTerm.app ]] || return
  mkdir -p $dir
  local black white bblack bwhite
  if [[ $THEME_MODE == light ]]; then black=$SUBTEXT1 white=$SURFACE2 bblack=$SUBTEXT0 bwhite=$SURFACE1
  else black=$SURFACE1 white=$SUBTEXT1 bblack=$SURFACE2 bwhite=$SUBTEXT0; fi
  local ansi=($black $RED $GREEN $YELLOW $BLUE $PINK $TEAL $white $bblack $RED $GREEN $YELLOW $BLUE $PINK $TEAL $bwhite)
  /usr/bin/python3 - "$dir/rice.json" $BASE $TEXT $ROSEWATER $SURFACE2 $ACCENT "${ansi[@]}" <<'PY'
import json, sys
out, bg, fg, cursor, sel, accent, *ansi = sys.argv[1:]
def c(h): return {"Red Component": int(h[0:2], 16) / 255, "Green Component": int(h[2:4], 16) / 255,
                  "Blue Component": int(h[4:6], 16) / 255, "Alpha Component": 1, "Color Space": "sRGB"}
prof = {"Name": "Rice", "Guid": "rice-theme-switcher", "Dynamic Profile Parent Name": "Default",
        "Use Separate Colors for Light and Dark Mode": False,
        "Background Color": c(bg), "Foreground Color": c(fg), "Bold Color": c(fg),
        "Cursor Color": c(cursor), "Cursor Text Color": c(bg), "Selection Color": c(sel),
        "Selected Text Color": c(fg), "Link Color": c(accent), "Badge Color": c(accent)}
prof.update({f"Ansi {i} Color": c(h) for i, h in enumerate(ansi)})
json.dump({"Profiles": [prof]}, open(out, "w"), indent=1)
PY
  local seq=$'\e]10;#'$TEXT$'\a\e]11;#'$BASE$'\a\e]12;#'$ROSEWATER$'\a'
  local i; for i in {0..15}; do seq+=$'\e]4;'$i';#'${ansi[i+1]}$'\a'; done
  seq+=$'\e]1337;SetColors=selbg='$SURFACE2$'\a\e]1337;SetColors=selfg='$TEXT$'\a'
  # iTerm sessions are `login` processes whose parent is an iTermServer
  # (pgrep can't see them since login is setuid; the path has a space, so match $0).
  local tty
  for tty in $(ps -axo pid=,ppid=,tty=,comm= | awk '/iTermServer/ {s[$1]=1} {l[NR]=$2" "$3}
               END {for (i in l) {split(l[i], f, " "); if ((f[1] in s) && f[2] != "??") print f[2]}}'); do
    [[ -w /dev/$tty ]] && printf '%s' "$seq" > /dev/$tty
  done
}

apply_discord() {
  # Vencord theme "rice.theme.css": Discord colour variables from the palette. Vencord
  # watches its themes folder, so Discord recolours live.
  local dir="$HOME/Library/Application Support/Vencord/themes"
  [[ -d $dir ]] || return
  cat > $dir/rice.theme.css <<EOF
/**
 * @name Rice
 * @description Follows the desktop theme switcher (~/.local/bin/theme). Generated — edit the palette, not this file.
 * @author theme-switcher
 * @version 1.0.0
 */
/* Generated for $THEME_LABEL */
:is(:root, .theme-dark, .theme-light, .theme-darker, .theme-midnight, .visual-refresh) {
  --background-base-lowest: #$CRUST !important;
  --background-base-lower: #$MANTLE !important;
  --background-base-low: #$MANTLE !important;
  --background-surface-high: #$BASE !important;
  --background-surface-higher: #$SURFACE0 !important;
  --background-surface-highest: #$SURFACE1 !important;
  --background-primary: #$BASE !important;
  --background-secondary: #$MANTLE !important;
  --background-secondary-alt: #$CRUST !important;
  --background-tertiary: #$CRUST !important;
  --background-floating: #$CRUST !important;
  --background-nested-floating: #$MANTLE !important;
  --background-accent: #$SURFACE1 !important;
  --background-modifier-hover: #${SURFACE0}80 !important;
  --background-modifier-active: #${SURFACE1}99 !important;
  --background-modifier-selected: #${SURFACE1}cc !important;
  --background-message-hover: #${SURFACE0}55 !important;
  --bg-base-primary: #$BASE !important;
  --bg-base-secondary: #$MANTLE !important;
  --bg-base-tertiary: #$CRUST !important;
  --bg-surface-raised: #$SURFACE0 !important;
  --bg-surface-overlay: #$CRUST !important;
  --app-frame-background: #$CRUST !important;
  --chat-background-default: #$BASE !important;
  --channeltextarea-background: #$SURFACE0 !important;
  --input-background: #$SURFACE0 !important;
  --modal-background: #$BASE !important;
  --modal-footer-background: #$MANTLE !important;
  --border-subtle: #$SURFACE0 !important;
  --border-faint: #$SURFACE0 !important;
  --text-default: #$TEXT !important;
  --text-normal: #$TEXT !important;
  --text-strong: #$TEXT !important;
  --text-muted: #$OVERLAY1 !important;
  --text-link: #$BLUE !important;
  --header-primary: #$TEXT !important;
  --header-secondary: #$SUBTEXT0 !important;
  --interactive-normal: #$SUBTEXT1 !important;
  --interactive-hover: #$TEXT !important;
  --interactive-active: #$TEXT !important;
  --interactive-muted: #$SURFACE2 !important;
  --channels-default: #$SUBTEXT0 !important;
  --channel-icon: #$OVERLAY1 !important;
  --brand-500: #$ACCENT !important;
  --brand-560: #$ACCENT !important;
  --brand-experiment: #$ACCENT !important;
  --brand-experiment-560: #$ACCENT !important;
  --control-brand-foreground: #$ACCENT !important;
  --button-filled-brand-background: #$ACCENT !important;
  --button-filled-brand-background-hover: #$LAVENDER !important;
  --button-filled-brand-background-active: #$LAVENDER !important;
  --control-brand-primary-background-default: #$ACCENT !important;
  --control-brand-primary-background-hover: #$LAVENDER !important;
  --control-brand-primary-background-active: #$LAVENDER !important;
  --control-brand-primary-text-default: #$CRUST !important;
  --control-primary-background-default: #$ACCENT !important;
  --control-primary-background-hover: #$LAVENDER !important;
  --control-primary-background-active: #$LAVENDER !important;
  --control-primary-text-default: #$CRUST !important;
  --brand-260: #$LAVENDER !important;
  --brand-360: #$ACCENT !important;
  --brand-400: #$ACCENT !important;
  --brand-460: #$ACCENT !important;
  --brand-530: #$ACCENT !important;
  --brand-600: #$ACCENT !important;
  --button-filled-brand-text: #$CRUST !important;
  --mention-foreground: #$ACCENT !important;
  --mention-background: #${ACCENT}26 !important;
  --info-positive-foreground: #$GREEN !important;
  --info-danger-foreground: #$RED !important;
  --info-warning-foreground: #$YELLOW !important;
  --scrollbar-auto-thumb: #$SURFACE1 !important;
  --scrollbar-thin-thumb: #$SURFACE1 !important;
}
EOF
}

apply_wallpaper() {
  local wp=${1:-$(wallpaper_for $NAME)}
  if [[ -z $wp ]]; then
    wp=$THEMES/wallpapers/generated/$NAME.png
    mkdir -p ${wp:h}
    print "  generating wallpaper…"
    /usr/bin/python3 $THEMES/make-wallpaper.py $PALETTES/$NAME.sh $wp
  fi
  osascript -e "tell application \"System Events\" to tell every desktop to set picture to POSIX file \"$wp\"" >/dev/null
  echo $wp > $CURRENT/wallpaper
}

apply() {
  NAME=$1
  [[ -f $PALETTES/$NAME.sh ]] || { print -u2 "theme: no palette '$NAME' (try: theme --list)"; exit 1 }
  source $PALETTES/$NAME.sh
  mkdir -p $CURRENT
  ln -sfn $PALETTES/$NAME.sh $CURRENT/palette.sh
  echo $NAME > $CURRENT/name

  print "→ $THEME_LABEL"
  local dark=$([[ $THEME_MODE == light ]] && echo false || echo true)
  osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $dark" >/dev/null
  apply_wallpaper
  apply_firefox
  apply_spotify
  apply_alacritty
  apply_iterm
  apply_vscode
  apply_discord
  apply_btop
  apply_zed
  apply_zellij
  apply_nvim
  pgrep -xq borders && borders active_color=0xff$ACCENT inactive_color=0x00$SURFACE1
  pgrep -xq sketchybar && sketchybar --reload
  print "  done (btop picks it up on next launch)"
}

case $1 in
  --list) list ;;
  --current) cat $CURRENT/name 2>/dev/null ;;
  --preview) preview $2 ;;
  --wallpaper)
    shift; NAME=$(cat $CURRENT/name)
    (( $# )) || { print -u2 "usage: theme --wallpaper <image…>"; exit 1 }
    mkdir -p $THEMES/wallpapers/$NAME
    for img in "$@"; do cp "$img" $THEMES/wallpapers/$NAME/ && print "added ${img:t} → $NAME"; done
    apply_wallpaper ;;
  --next-wallpaper) NAME=$(cat $CURRENT/name); apply_wallpaper ;;
  --set-wallpaper)
    [[ -f $2 ]] || { print -u2 "usage: theme --set-wallpaper <image>"; exit 1 }
    NAME=$(cat $CURRENT/name); apply_wallpaper ${2:A} ;;
  --new)
    [[ -n $2 ]] || { print -u2 "usage: theme --new <name> [from-theme]"; exit 1 }
    from=${3:-$(cat $CURRENT/name)}
    [[ -f $PALETTES/$2.sh ]] && { print -u2 "theme: '$2' already exists"; exit 1 }
    sed "s|^THEME_LABEL=.*|THEME_LABEL=\"$2\"|" $PALETTES/$from.sh > $PALETTES/$2.sh
    print "created $PALETTES/$2.sh (copy of $from) — edit the colours, then: theme $2"
    ${EDITOR:-nvim} $PALETTES/$2.sh
    pgrep -xq sketchybar && sketchybar --reload ;;
  -h|--help) sed -n '2,14p' $0 | sed 's/^# \{0,1\}//' ;;
  "")
    pick=$(list | fzf --prompt="theme › " --height=~60% --layout=reverse --border=rounded \
                      --header="current: $(cat $CURRENT/name 2>/dev/null)" \
                      --preview="$0 --preview {}" --preview-window=right,60%) || exit 0
    apply $pick ;;
  *) apply $1 ;;
esac

{
  "title": "Rice: Hyper key + app/widget shortcuts",
  "rules": [
    {
      "description": "Caps Lock: hold = Hyper (Ctrl+Option+Cmd), tap = Caps Lock",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_control",
              "modifiers": [
                "left_option",
                "left_command"
              ]
            }
          ],
          "to_if_alone": [
            {
              "key_code": "caps_lock",
              "hold_down_milliseconds": 200
            }
          ]
        }
      ]
    },
    {
      "description": "Disable all numpad keys",
      "manipulators": [
        {
          "from": {
            "key_code": "keypad_num_lock",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "vk_none"
            }
          ],
          "type": "basic"
        },
        {

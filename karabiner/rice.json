    {
      "description": "Ctrl+Option+Cmd+T opens a new Alacritty window",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "t",
            "modifiers": {
              "mandatory": [
                "control",
                "option",
                "command"
              ]
            }
          },
          "to": [
            {
              "shell_command": "~/.local/bin/alacritty-new-window"
            }
          ]
        }
      ]
    },
    {
      "description": "Ctrl+Option+Cmd+B opens Firefox",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "b",
            "modifiers": {
              "mandatory": [
                "control",
                "option",
                "command"
              ]
            }
          },
          "to": [
            {
              "shell_command": "/usr/bin/open -a /Applications/Firefox.app"
            }
          ]
        }
      ]
    },
    {
